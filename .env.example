# Copy to .env and adjust before `docker compose up`.
# The app also runs without this file using the local demo AI provider.

POSTGRES_PASSWORD=change-me

# 加密用户保存在数据库中的 AI API Key，至少 16 个字符。
# 生产环境请使用随机长字符串并妥善备份；更换后旧 Key 需要用户重新保存。
APP_AI_ENCRYPTION_KEY=change-me-32-characters-minimum

# 服务端兜底 AI。用户自己的默认 AI 配置优先。
AI_PROVIDER=mock
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# HTTPS 环境设为 true。
# SESSION_COOKIE_SECURE=true
